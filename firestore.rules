rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    // Anyone can submit a NEW detailed inquiry without signing in.
    // Only an authenticated JN COS TECH admin can read or manage it.
    match /inquiries/{inquiryId} {
      allow create: if request.resource.data.type == 'inquiry'
                    && request.resource.data.id == inquiryId;
      allow read, update, delete: if isAdmin();
    }

    // Anyone can submit a NEW quick contact request without signing in.
    // Only an authenticated JN COS TECH admin can read or manage it.
    match /contacts/{contactId} {
      allow create: if request.resource.data.type == 'contact'
                    && request.resource.data.id == contactId;
      allow read, update, delete: if isAdmin();
    }

    // Public website sessions can create/update their own session document.
    // Only an authenticated admin can read traffic data.
    match /visits/{sessionId} {
      allow create, update: if request.resource.data.type == 'visit'
                            && request.resource.data.id == sessionId
                            && request.resource.data.sessionId == sessionId;
      allow read, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
